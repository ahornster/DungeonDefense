    m_Modifications:
    - target: {fileID: 2974659950942323212, guid: 9f9b37cd4101347409b01b01f8ba5d7f, type: 3}
      propertyPath: m_text
      value: "Dungeon Defense is a tower defense game. As the player, you are tasked
        with defending your treasure chest from invading adventurers. \n\nYou can
        defend your treasure chests by creating turrets and delving deeper into the
        dungeon by opening doors.\n\nTo win the game, survive till the end of the
        waves and defeat all remaining enemies in the dungeon. \n\nYou will lose
        the game if the treasure chest ever reaches '0' health."
      objectReference: {fileID: 0}
